# PostgreSQL
DATABASE_URL="postgresql://app:app@localhost:5433/rewards?schema=public"

# Session cookie
SESSION_SECRET="replace-me-with-a-long-random-string"
SESSION_TTL_DAYS="7"

# Delivery provider: fake | real
PROVIDER_MODE="fake"
DIGITAL_GOODS_BASE_URL="https://digital-goods-api.vercel.app/api/v1"
DIGITAL_GOODS_API_KEY=""
# Optional outbound proxy for the delivery API (e.g. local Clash on 127.0.0.1:7897)
# DIGITAL_GOODS_PROXY="http://127.0.0.1:7897"
PROVIDER_TIMEOUT_MS="15000"

# Reconciler worker
WORKER_INTERVAL_MS="20000"
WORKER_BATCH_SIZE="3"
